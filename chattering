#!/usr/bin/env node
// chattering — query the conversation records from any folder, for people and
// for agents. `chattering` alone answers "where was I?". The other commands
// search and read conversations, notes, project memory, epics and evidence.
// Every answer is plain text rendered by the server (records.js), so this
// file only parses arguments and prints. Run `chattering help` for the list.
'use strict';
require('./win-hide.js'); // first: on Windows nothing this starts opens a window (design/70)
const http = require('http');
const path = require('path');

// The server's port: named, else where the launcher of a download started it
// (server.json in Chattering's data folder), else the default.
const PORT = Number(process.env.CHATTERING_PORT || process.env.PORT || (() => {
  try { return JSON.parse(require('fs').readFileSync(require('path').join(require('./platform.js').appDirs().data, 'server.json'), 'utf8')).port; } catch { return 0; }
})() || 7433);
// Being on this machine is not a credential (a guest's sandboxed agent is
// on it too): the token comes from the environment, else from the install
// token file, which only the account can read.
const TOKEN = process.env.CHATTERING_TOKEN || (() => {
  try { return require('fs').readFileSync(process.env.CHATTERING_TOKEN_FILE || require('path').join(require('./platform.js').appDirs().cache, 'lan-token'), 'utf8').trim(); } catch { return ''; }
})();

// Long options that take a value. Anything else that starts with -- is a flag.
const VALUED = new Set(['project', 'since', 'role', 'type', 'limit', 'offset', 'exclude', 'at', 'context',
  'from', 'to', 'last', 'roles', 'max', 'area', 'epic', 'kind', 'dir', 'name', 'folder']);

function parse(argv) {
  const positional = [];
  const opts = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--') { positional.push(...argv.slice(i + 1)); break; }
    if (!a.startsWith('--')) { positional.push(a); continue; }
    const eq = a.indexOf('=');
    let name = eq > 0 ? a.slice(2, eq) : a.slice(2);
    let value = eq > 0 ? a.slice(eq + 1) : undefined;
    if (name.startsWith('no-')) { opts[name.slice(3)] = 'false'; continue; }
    if (VALUED.has(name)) {
      if (value === undefined) {
        if (i + 1 >= argv.length) fail(`--${name} needs a value`);
        value = argv[++i];
      }
      opts[name] = value;
    } else {
      opts[name] = value === undefined ? 'true' : value;
    }
  }
  return { positional, opts };
}

function fail(msg, code = 2) {
  process.stderr.write(msg + '\n');
  process.exit(code);
}

// Command → server op + query parameters.
function plan(positional, opts) {
  const [cmd, ...rest] = positional;
  const cwd = process.cwd();
  const params = { dir: opts.dir ? path.resolve(opts.dir) : cwd };
  const pass = names => { for (const n of names) if (opts[n] !== undefined) params[n] = opts[n]; };
  switch (cmd || 'here') {
    case 'help': case '--help': case '-h': return { op: 'help', params: {} };
    case 'here':
      if (rest[0]) params.dir = path.resolve(rest[0]);
      return { op: 'here', params };
    case 'search': {
      const q = rest.join(' ').trim();
      if (!q) fail('usage: chattering search "<words>" [--project NAME] [--since 30d]');
      params.q = q;
      pass(['project', 'since', 'role', 'type', 'limit', 'offset', 'exclude', 'max', 'semantic', 'prefix']);
      return { op: 'search', params };
    }
    case 'show': {
      if (!rest[0]) fail('usage: chattering show <id> [--at N] [--context K] [--from A --to B] [--last N] [--roles all]');
      params.id = rest[0];
      pass(['at', 'context', 'from', 'to', 'last', 'roles', 'max']);
      return { op: 'show', params };
    }
    case 'conversations': case 'convs': case 'ls':
      if (rest[0]) params.project = rest[0];
      pass(['project', 'since', 'limit', 'max']);
      if (opts.here) params.underDir = 'true';
      return { op: 'conversations', params };
    case 'projects': return { op: 'projects', params };
    case 'memory': case 'map': {
      // chattering memory [PROJECT] [KIND] | chattering memory --epic ID [KIND]
      const kinds = new Set(['overview', 'intent', 'environment', 'status']);
      for (const r of rest) { if (kinds.has(r)) params.kind = r; else params.project = r; }
      pass(['project', 'area', 'epic', 'kind', 'max']);
      return { op: 'memory', params };
    }
    case 'notes':
      if (rest[0]) params.project = rest[0];
      pass(['project', 'limit', 'max']);
      return { op: 'notes', params };
    case 'note':
      if (!rest[0]) fail('usage: chattering note <conversation id | file under ~/notes/chattering>');
      params.id = rest[0].startsWith('~/') ? path.join(require('os').homedir(), rest[0].slice(2)) : rest[0];
      pass(['max']);
      return { op: 'note', params };
    case 'epics':
      if (rest[0]) params.project = rest[0];
      pass(['project', 'limit', 'max']);
      return { op: 'epics', params };
    case 'epic':
      if (!rest[0]) fail('usage: chattering epic <id>');
      params.id = rest[0];
      pass(['max']);
      return { op: 'epic', params };
    // Sharing with other installs: these talk to this machine's server,
    // which does the handshake and the copying (design/52).
    case 'join': {
      if (!rest[0]) fail('usage: chattering join <invite link> [--name "Your Name"] [--folder /path/to/checkout]');
      return { op: 'sync/join-remote', method: 'POST', params: { link: rest[0], name: opts.name || '', folder: opts.folder ? path.resolve(opts.folder) : '' } };
    }
    case 'sync': return { op: 'sync/now', method: 'POST', params: { all: opts.all === 'true' } };
    case 'peers': return { op: 'sync/peers', method: 'GET', params: {} };
    case 'project-id': return { op: 'project-id', method: 'GET', params: { project: rest[0] || '', dir: params.dir } };
    case 'evidence':
      if (!rest[0]) fail('usage: chattering evidence <id>');
      params.id = rest[0];
      pass(['max']);
      return { op: 'evidence', params };
    default:
      fail(`unknown command "${cmd}". Run: chattering help`);
  }
}

function get(op, params) {
  const qs = new URLSearchParams();
  for (const [k, v] of Object.entries(params)) if (v !== undefined && v !== null && v !== '') qs.set(k, String(v));
  const headers = TOKEN ? { Authorization: 'Bearer ' + TOKEN } : {};
  return new Promise((resolve, reject) => {
    const req = http.get({ host: '127.0.0.1', port: PORT, path: `/api/records/${op}?${qs}`, headers }, res => {
      let body = '';
      res.setEncoding('utf8');
      res.on('data', c => body += c);
      res.on('end', () => {
        let data = null;
        try { data = JSON.parse(body); } catch { data = { error: body.slice(0, 300) || `HTTP ${res.statusCode}` }; }
        resolve({ status: res.statusCode, data });
      });
    });
    req.on('error', reject);
  });
}

// The sharing commands use the plain API and print their own words.
function api(method, pathname, params) {
  const headers = { ...(TOKEN ? { Authorization: 'Bearer ' + TOKEN } : {}), 'Content-Type': 'application/json' };
  const qs = new URLSearchParams();
  if (method === 'GET') for (const [k, v] of Object.entries(params)) if (v !== undefined && v !== null && v !== '') qs.set(k, String(v));
  return new Promise((resolve, reject) => {
    const req = http.request({ host: '127.0.0.1', port: PORT, method, path: `/api/${pathname}${qs.size ? '?' + qs : ''}`, headers }, res => {
      let body = '';
      res.setEncoding('utf8');
      res.on('data', c => body += c);
      res.on('end', () => { let data = null; try { data = JSON.parse(body); } catch { data = { error: body.slice(0, 300) || `HTTP ${res.statusCode}` }; } resolve({ status: res.statusCode, data }); });
    });
    req.on('error', reject);
    if (method !== 'GET') req.end(JSON.stringify(params)); else req.end();
  });
}
function sharingText(op, d) {
  if (op === 'sync/join-remote') {
    const lines = [`Joined ${d.projects.map(p => p.name + (p.cwd ? ' (' + p.cwd + ')' : '')).join(', ')} on ${d.peer.name} as ${d.me.name}.`];
    lines.push(`${d.them.name} is now a guest on this machine, listed on ${d.projects.length === 1 ? 'that project' : 'those projects'} only.`);
    if (!d.projects.some(p => p.cwd)) lines.push('No local folder yet: the project shows up here from its mirrors. Clone it and run the join again with --folder to bind it.');
    lines.push(d.reachableFromThem ? 'They can pull from this machine, and this one pulls from theirs.' : 'This machine has no public address, so it pushes its side to them and pulls theirs; nothing needs to reach it.');
    if (d.sync) lines.push(`First sync: ${d.sync.pulled} conversation${d.sync.pulled === 1 ? '' : 's'} pulled, ${d.sync.pushed} pushed${d.sync.skipped ? ' (' + d.sync.skipped + ')' : ''}.`);
    lines.push('Peers sync every minute; `chattering sync` runs one now.');
    return lines.join('\n');
  }
  if (op === 'sync/now') {
    const rows = d.peers.map(p => { const r = (d.results || {})[p.id] || {}; return `${p.name}: ${r.skipped ? r.skipped : `${r.pulled || 0} pulled, ${r.pushed || 0} pushed`}${p.lastError ? ' — ' + p.lastError : ''}`; });
    return rows.length ? rows.join('\n') : 'No peers. Someone invites you with a link, then: chattering join <link>.';
  }
  if (op === 'sync/peers') {
    if (!d.peers.length) return `No peers on ${d.host}. Someone invites you with a link, then: chattering join <link>.`;
    return d.peers.map(p => `${p.name}${p.paused ? ' (paused)' : ''} — ${p.reachable ? p.url : 'pushes to us (no address)'}\n  projects: ${p.projects.map(x => x.name + ' (' + x.right + ')').join(', ') || '(none)'}\n  last pull ${p.lastPullAt || 'never'} · last push ${p.lastPushAt || 'never'}${p.lastError ? '\n  error: ' + p.lastError : ''}`).join('\n');
  }
  if (op === 'project-id') return `${d.name}: ${d.id}\n  folder: ${d.cwd || '(none)'} · marker ${d.marker ? 'in .chattering/project.json (commit it)' : 'not written yet (an invite writes it)'} · sharing policy: ${d.policy}`;
  return JSON.stringify(d, null, 2);
}

// ---- chattering program … (design/75) ----
// The same routes the Programs pages use; every answer in plain words.
function request(method, pathname, body, { accept = 'application/json', onLine = null } = {}) {
  const headers = { ...(TOKEN ? { Authorization: 'Bearer ' + TOKEN } : {}), 'Content-Type': 'application/json', Accept: accept };
  return new Promise((resolve, reject) => {
    const req = http.request({ host: '127.0.0.1', port: PORT, method, path: pathname, headers }, res => {
      let text = '', carry = '';
      res.setEncoding('utf8');
      res.on('data', c => {
        text += c;
        if (!onLine) return;
        carry += c;
        const lines = carry.split('\n'); carry = lines.pop();
        for (const l of lines) if (l.trim()) { try { onLine(JSON.parse(l)); } catch {} }
      });
      res.on('end', () => { let data = null; try { data = JSON.parse(text); } catch { data = null; } resolve({ status: res.statusCode, data, text }); });
    });
    req.on('error', reject);
    req.end(body === undefined ? undefined : JSON.stringify(body));
  });
}
const shown = v => (typeof v === 'string' ? v : JSON.stringify(v));
async function programCommand(rest, opts) {
  const [sub, name, arg] = rest;
  const need = what => { if (!name) fail(`usage: chattering program ${sub} NAME${what ? ' ' + what : ''}`); };
  const inputsOf = () => { if (!arg) fail(`usage: chattering program ${sub} NAME '{"input": …}'`); try { return JSON.parse(arg); } catch { fail('the inputs are JSON, like \'{"message": "hi"}\''); } };
  const ok = r => { if (r.status !== 200) fail('error: ' + ((r.data && r.data.error) || r.text.slice(0, 300) || r.status), 1); return r.data; };
  if (!sub) {
    const d = ok(await request('GET', '/api/programs'));
    const made = d.programs.filter(p => p.made);
    if (opts.json) return console.log(JSON.stringify(made, null, 2));
    if (!made.length) return console.log('No program made here yet. Make one on the AI programs page, or: chattering program create FILE');
    for (const p of made) console.log(`${p.name}${p.live ? ' (live)' : ' (not published)'}${p.project ? ' · ' + p.project : ''} · ${p.calls} call${p.calls === 1 ? '' : 's'}`);
    return;
  }
  if (sub === 'show') {
    need();
    const v = ok(await request('GET', '/api/programs/made?name=' + encodeURIComponent(name)));
    if (opts.json) return console.log(JSON.stringify(v, null, 2));
    const vn = x => (x && x.n ? 'v' + x.n : 'a new version');
    console.log(`${v.name} — /programs/${v.name}`);
    console.log(`  folder: ${v.folder}${v.project ? ' (project ' + v.project + ')' : ''}`);
    console.log(`  live: ${v.live ? vn(v.live) + ', published ' + v.live.at : 'not published'}; draft: ${v.error ? 'cannot run: ' + v.error : vn(v.draft) + (v.live && v.draft && v.live.version === v.draft.version ? ' (the same)' : '')}`);
    if (v.definition) {
      const d = v.definition, shape = s => (s.enum ? 'one of ' + s.enum.join(', ') : s.type === 'array' ? 'list' : s.type || 'value');
      console.log(`  takes: ${d.inputs.map(i => `${i.name} (${shape(i.shape)})`).join(', ')}`);
      console.log(`  answers: ${d.outputs.map(o => `${o.name} (${shape(o.shape)})`).join(', ')}`);
    }
    console.log(`  keys: ${v.keys.length ? v.keys.map(k => `${k.label} ${k.prefix}…`).join(', ') : 'none (make one on its Endpoint tab)'}`);
    return;
  }
  if (sub === 'create') {
    if (!name) fail('usage: chattering program create FILE [--project NAME]');
    let definition;
    try { definition = JSON.parse(require('fs').readFileSync(name, 'utf8')); } catch (e) { fail(`cannot read ${name}: ${e.message}`); }
    const d = ok(await request('POST', '/api/programs/create', { definition, project: opts.project || null }));
    return console.log(`Made ${d.name}: ${d.folder}\nTry it: chattering program try ${d.name} '{…}'`);
  }
  if (sub === 'try') {
    need('\'{…}\'');
    let last = null;
    const r = await request('POST', '/api/programs/try', { name, inputs: inputsOf() }, { onLine: e => { if (e.type === 'done' || e.type === 'error') last = e; } });
    if (r.status !== 200 && !last) ok(r);
    if (!last) fail('no answer', 1);
    if (last.type === 'error') fail('error: ' + last.error, 1);
    if (opts.json) return console.log(JSON.stringify(last, null, 2));
    return console.log(Object.keys(last.outputs).length === 1 ? shown(Object.values(last.outputs)[0]) : Object.entries(last.outputs).map(([k, v]) => `${k}: ${shown(v)}`).join('\n'));
  }
  if (sub === 'test') {
    need();
    let done = null;
    const r = await request('POST', '/api/programs/test', { name }, { onLine: e => {
      if (e.type === 'row' && e.verdict !== 'right') console.log(`${e.verdict}: ${Object.values(e.inputs).map(shown).join(' · ').slice(0, 120)} — expected ${shown(e.expected)}, got ${e.error || shown(e.got)}`);
      if (e.type === 'done') done = e;
    } });
    if (r.status !== 200 && !done) ok(r);
    if (!done) fail('the test did not finish', 1);
    return console.log(`${done.right} of ${done.total} right${done.worded ? `, ${done.worded} in other words` : ''}${done.wrong ? `, ${done.wrong} wrong` : ''}${done.failed ? `, ${done.failed} failed` : ''}.`);
  }
  if (sub === 'publish') {
    need();
    const v = ok(await request('POST', '/api/programs/publish', { name }));
    return console.log(`Published: v${v.live.n || '?'} answers at /programs/${v.name}.`);
  }
  if (sub === 'call') {
    need('\'{…}\'');
    const r = await request('POST', '/programs/' + encodeURIComponent(name), inputsOf());
    const d = ok(r);
    if (opts.json) return console.log(JSON.stringify(d, null, 2));
    return console.log(shown(d.result));
  }
  fail(`unknown: chattering program ${sub}. Run: chattering help`);
}

async function main() {
  const { positional, opts } = parse(process.argv.slice(2));
  if (positional[0] === 'program' || positional[0] === 'programs') {
    try { await programCommand(positional.slice(1), opts); }
    catch (e) { fail(`chattering server is not answering on port ${PORT} (${e.code || e.message}).`, 3); }
    return;
  }
  const { op, params, method } = plan(positional, opts);
  let r;
  if (method) {
    try { r = await api(method, op, params); }
    catch (e) { fail(`chattering server is not answering on port ${PORT} (${e.code || e.message}).`, 3); }
    if (opts.json) { process.stdout.write(JSON.stringify(r.data, null, 2) + '\n'); process.exit(r.status === 200 ? 0 : 1); }
    if (r.status !== 200) fail('error: ' + (r.data.error || r.status), 1);
    process.stdout.write(sharingText(op, r.data) + '\n');
    return;
  }
  try { r = await get(op, params); }
  catch (e) {
    fail(`chattering server is not answering on port ${PORT} (${e.code || e.message}).\n` +
      `Start it: systemctl --user start chattering   (or: node ~/Projects/chattering/server.js)`, 3);
  }
  if (opts.json) {
    process.stdout.write(JSON.stringify(r.data, null, 2) + '\n');
    process.exit(r.status === 200 ? 0 : 1);
  }
  if (r.status !== 200) fail(r.data.text || ('error: ' + (r.data.error || r.status)), 1);
  let text = r.data.text || '';
  // A person at a terminal gets a bold first line; agents and pipes get plain text.
  if (process.stdout.isTTY && text) {
    const nl = text.indexOf('\n');
    text = nl > 0 ? '\x1b[1m' + text.slice(0, nl) + '\x1b[0m' + text.slice(nl) : '\x1b[1m' + text + '\x1b[0m';
  }
  process.stdout.write(text + '\n');
}

main();
