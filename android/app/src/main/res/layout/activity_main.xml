<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <app.rockfrog.chattering.PasteSafeWebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <app.rockfrog.chattering.InkOverlay
        android:id="@+id/ink"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Plain text while connecting: no spinner, readable on e-ink. -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#000000"
        android:textSize="18sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:text="Chattering"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:text="Connect to one Chattering server by its address: its Tailscale address works at home and away (the app turns Tailscale on when needed), a home-network address only at home."
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="server address"
                android:textColor="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="http://100.x.y.z:7433"
                android:inputType="textUri"
                android:textColor="#000000"
                android:textColorHint="#666666" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="token"
                android:textColor="#000000"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/token"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="from ~/.cache/chattering/lan-token"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:textColor="#000000"
                android:textColorHint="#666666" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="open Chattering"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/pairInstead"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="pair with a computer instead (no address needed)"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
